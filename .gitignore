*.log
.DS_Store

# --- environment / secrets (ores-sops + age) -------------------------------
# Plaintext dotenv is local-only at every depth, including common suffixes.
*.env
*/*.env
*/**/*.env
.env.*
*.env.*
!.env.example

# Decrypted material is runtime-only.
/env/dec/

# Deny every encrypted environment path, then permit only the two canonical
# version-controlled stores. This prevents one-off/misspelled env names from
# becoming an unaudited configuration authority.
/env/enc/*
!/env/enc/dev.env.enc
!/env/enc/prod.env.enc

# age private keys — never commit these.
*.agekey
*.age-key
keys.txt
sops-private*.txt

# rendered output / local secrets — never commit
rendered/
*.local.yaml
secrets/

# Terraform plans/state and local variable files can contain provider credentials,
# join tokens, and infrastructure identifiers. Provider lock files stay tracked.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example
crash.log
*.kubeconfig

# Operator evidence is generated outside the checkout; ignore an accidental
# repository-local default as a final defense against credential/status leakage.
/evidence/

# Scratch / git worktrees (tmp/worktrees/*)
tmp/

# Generated Python bytecode is never source or review evidence.
__pycache__/
*.py[cod]

# --- hardened baseline (auto) ---
Thumbs.db
*.swp
*~
.direnv/
node_modules/
dist/
.next/
.astro/
.cache/
coverage/
**/target/
*.tsbuildinfo
pkg/
pkg-node/
*-debug.log*
tmp
temp
tmp/worktrees
temp/worktrees
