watch_file .nix/flake.nix
watch_file .nix/flake.lock
use flake ./.nix

# Legacy path, kept so existing local setups keep working: a hand-made,
# gitignored .env with HCLOUD_TOKEN / VULTR_API_KEY / CIVO_TOKEN.
# DEPRECATED — migrate those values into env/enc/prod.env.enc:
#     just env-edit prod        # paste the real tokens
#     just env-run prod terraform -chdir=terraform/envs/prod plan
#     just env-run prod hcloud server list
dotenv_if_exists .env

# Secrets from env/enc are deliberately NOT auto-loaded here. An auto-loaded
# cloud token is in the environment of every subprocess started from this
# directory; `just env-run` scopes it to the one command that needs it.
