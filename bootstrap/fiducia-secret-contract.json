{
  "schemaVersion": 1,
  "contractId": "den-434-fiducia-bootstrap-secrets-v1",
  "clusters": [
    "laptop-aws-sim",
    "laptop-gcp-sim",
    "laptop-azure-sim"
  ],
  "cloudRecoveryStore": "dd-cluster-secrets",
  "dynamicFiduciaStore": "dd-fiducia-kv",
  "maximumObservationAgeMinutes": 60,
  "maximumExternalSecretRefreshAgeMinutes": 30,
  "maximumRotationAgeDays": 90,
  "requiredReaderScopes": [
    "kv:read"
  ],
  "minimumByteLengths": {
    "FIDUCIA_KEY_IDEMPOTENCY_SECRET": 32,
    "CUSTOMER_API_KEY_PEPPER": 32
  },
  "noWhitespaceProperties": [
    "FIDUCIA_KEY_IDEMPOTENCY_SECRET",
    "CUSTOMER_API_KEY_PEPPER"
  ],
  "stores": [
    "dd-cluster-secrets",
    "dd-fiducia-kv"
  ],
  "cloudObjects": [
    {
      "name": "dd/remote-dev/fiducia-eso-reader",
      "trustDomain": "eso-reader",
      "namespace": "external-secrets",
      "externalSecret": "fiducia-eso-reader",
      "targetSecret": "fiducia-eso-reader",
      "properties": {
        "FIDUCIA_API_KEY": "token"
      },
      "dedicatedOrganizationRequired": true,
      "scopeProperty": "FIDUCIA_API_KEY"
    },
    {
      "name": "dd/remote-dev/fiducia-kv-protection",
      "trustDomain": "kv-encryption",
      "namespace": "fiducia",
      "externalSecret": "fiducia-kv-protection",
      "targetSecret": "fiducia-kv-protection",
      "properties": {
        "FIDUCIA_KV_ENCRYPTION_KEYS": "encryption-keys",
        "FIDUCIA_KV_ENCRYPTION_ACTIVE_KEY_ID": "active-key-id"
      },
      "fullHistoricalKeySetRequired": true
    },
    {
      "name": "dd/remote-dev/fiducia-cluster-secrets",
      "trustDomain": "cluster-trust",
      "namespace": "fiducia",
      "externalSecret": "fiducia-cluster-secrets",
      "targetSecret": "fiducia-cluster-secrets",
      "properties": {
        "FIDUCIA_INTERNAL_SECRET": "internal-secret",
        "FIDUCIA_BRAIN_RAFT_SECRET": "brain-raft-secret"
      }
    },
    {
      "name": "dd/remote-dev/fiducia-auth-secrets",
      "trustDomain": "auth",
      "namespace": "fiducia",
      "externalSecret": "fiducia-auth-secrets",
      "targetSecret": "fiducia-auth-secrets",
      "properties": {
        "FIDUCIA_JWT_SIGNING_KEY": "jwt-signing-key",
        "FIDUCIA_INTROSPECT_SECRET": "introspect-secret",
        "FIDUCIA_KEY_IDEMPOTENCY_SECRET": "key-idempotency-secret",
        "CUSTOMER_API_KEY_PEPPER": "api-key-pepper",
        "SUPABASE_URL": "supabase-url",
        "SUPABASE_PUBLISHABLE_KEY": "supabase-publishable-key",
        "SUPABASE_SERVICE_ROLE_KEY": "supabase-service-role-key"
      }
    },
    {
      "name": "dd/remote-dev/fiducia-backend-secrets",
      "trustDomain": "customer-backend",
      "namespace": "fiducia",
      "externalSecret": "fiducia-backend-secrets",
      "targetSecret": "fiducia-backend-secrets",
      "properties": {
        "DATABASE_URL": "database-url",
        "SUPABASE_URL": "supabase-url",
        "SUPABASE_PUBLISHABLE_KEY": "supabase-publishable-key",
        "FIDUCIA_CUSTOMER_CSRF_SECRET": "csrf-secret"
      }
    },
    {
      "name": "dd/remote-dev/fiducia-admin-secrets",
      "trustDomain": "admin-backend",
      "namespace": "fiducia",
      "externalSecret": "fiducia-admin-secrets",
      "targetSecret": "fiducia-admin-secrets",
      "properties": {
        "FIDUCIA_ADMIN_CSRF_SECRET": "csrf-secret",
        "DATABASE_URL": "database-url",
        "SUPABASE_URL": "supabase-url",
        "SUPABASE_PUBLISHABLE_KEY": "supabase-publishable-key"
      }
    }
  ]
}
