{
  "schemaVersion": "ores.gcp-cloud-run.org.v1",
  "organization": "fiducia-cloud",
  "infraRepository": "fiducia-cloud/fiducia-infra",
  "canonicalDeploymentRepository": "ORESoftware/k8s-cluster",
  "centralModulePath": "gcp/cloud-run-rust-service",
  "gcp": { "projectId": null, "region": "us-central1", "state": "planned" },
  "services": [
    { "role": "web-server", "repository": "fiducia-cloud/fiducia-web-server.rs", "serviceName": "fiducia-web-server", "repositoryState": "present" },
    { "role": "admin-web-server", "repository": "fiducia-cloud/fiducia-admin-web-server.rs", "serviceName": "fiducia-admin-web-server", "repositoryState": "present" },
    { "role": "api-server", "repository": "fiducia-cloud/fiducia-api-server.rs", "serviceName": "fiducia-api-server", "repositoryState": "present" },
    { "role": "admin-api-server", "repository": "fiducia-cloud/fiducia-admin-api-server.rs", "serviceName": "fiducia-admin-api-server", "repositoryState": "present" }
  ],
  "probes": {
    "startup": { "path": "/readyz", "failureStatus": 503 },
    "liveness": { "path": "/healthz", "dependencyFree": true },
    "readiness": { "path": "/readyz", "failureStatus": 503 },
    "buildIdentity": { "path": "/version", "cacheControl": "no-store" },
    "metrics": { "path": "/metrics", "exposure": "private" }
  },
  "runtime": { "minInstances": 0, "maxInstances": 10, "imagePolicy": "digest-only", "serviceAccountPolicy": "per-service" },
  "kubernetes": { "startupPath": "/healthz", "livenessPath": "/healthz", "readinessPath": "/readyz" },
  "neon": { "organization": "fiducia-cloud", "project": "fiducia-cloud-prod", "database": "app", "state": "pending-external-provisioning" }
}
