{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fiducia.cloud/schemas/laptop-fleet-inventory-v1.json",
  "title": "Fiducia three-laptop fleet inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceMode",
    "capturedAt",
    "reviewedAt",
    "launchClassification",
    "hosts"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evidenceMode": { "enum": ["example", "live"] },
    "capturedAt": { "type": "string", "format": "date-time" },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "launchClassification": { "enum": ["beta-only", "limited-production"] },
    "fleetException": { "type": ["string", "null"], "minLength": 20, "maxLength": 2000 },
    "hosts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/host" }
    }
  },
  "$defs": {
    "evidenceId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:/-]{7,255}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clusterName",
        "syntheticProvider",
        "siteId",
        "serialHash",
        "hardware",
        "firmware",
        "network",
        "power",
        "hostPolicy",
        "monitoring",
        "evidence",
        "approval"
      ],
      "properties": {
        "clusterName": {
          "enum": ["laptop-aws-sim", "laptop-gcp-sim", "laptop-azure-sim"]
        },
        "syntheticProvider": { "enum": ["aws", "gcp", "azure"] },
        "siteId": { "pattern": "^site-[a-z0-9-]{1,32}$" },
        "physicalAccessOwner": { "type": "string", "minLength": 3, "maxLength": 120 },
        "serialHash": { "$ref": "#/$defs/sha256" },
        "hardware": {
          "type": "object",
          "additionalProperties": false,
          "required": ["manufacturer", "model", "architecture", "logicalCpuCount", "memoryMiB", "ethernet", "disk", "battery", "thermalSensors"],
          "properties": {
            "manufacturer": { "type": "string", "minLength": 2, "maxLength": 120 },
            "model": { "type": "string", "minLength": 2, "maxLength": 120 },
            "architecture": { "enum": ["x86_64", "aarch64"] },
            "logicalCpuCount": { "type": "integer", "minimum": 4, "maximum": 512 },
            "memoryMiB": { "type": "integer", "minimum": 16384, "maximum": 2097152 },
            "ethernet": { "const": true },
            "disk": {
              "type": "object",
              "additionalProperties": false,
              "required": ["device", "transport", "sizeGiB", "smartPassed", "rootEncrypted", "encryptionType", "healthPercent"],
              "properties": {
                "device": { "type": "string", "pattern": "^/dev/[a-zA-Z0-9._/-]+$" },
                "transport": { "enum": ["nvme", "sata"] },
                "sizeGiB": { "type": "integer", "minimum": 465, "maximum": 32768 },
                "smartPassed": { "const": true },
                "rootEncrypted": { "const": true },
                "encryptionType": { "enum": ["luks2"] },
                "healthPercent": { "type": "number", "minimum": 80, "maximum": 100 }
              }
            },
            "battery": {
              "type": "object",
              "additionalProperties": false,
              "required": ["present", "healthPercent", "cycleCount"],
              "properties": {
                "present": { "const": true },
                "healthPercent": { "type": "number", "minimum": 70, "maximum": 100 },
                "cycleCount": { "type": "integer", "minimum": 0, "maximum": 10000 }
              }
            },
            "thermalSensors": {
              "type": "object",
              "additionalProperties": false,
              "required": ["available", "loadTestMaxC", "throttledDuringLoadTest"],
              "properties": {
                "available": { "const": true },
                "loadTestMaxC": { "type": "number", "minimum": 20, "maximum": 95 },
                "throttledDuringLoadTest": { "const": false }
              }
            }
          }
        },
        "firmware": {
          "type": "object",
          "additionalProperties": false,
          "required": ["secureBoot", "tpmAvailable", "autoPowerOnAfterLoss", "firmwareUpdatedAt"],
          "properties": {
            "secureBoot": { "type": "boolean" },
            "secureBootException": { "type": ["string", "null"], "minLength": 20, "maxLength": 1000 },
            "tpmAvailable": { "type": "boolean" },
            "autoPowerOnAfterLoss": { "type": "boolean" },
            "manualRestartProcedure": { "type": ["string", "null"], "minLength": 20, "maxLength": 1000 },
            "firmwareUpdatedAt": { "type": "string", "format": "date-time" }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primaryTransport", "uploadMbps", "cgnat", "ispFingerprint", "failureDomainIndependent", "homeLanCidrs", "backupWan"],
          "properties": {
            "primaryTransport": { "const": "ethernet" },
            "uploadMbps": { "type": "number", "minimum": 10, "maximum": 100000 },
            "cgnat": { "type": "boolean" },
            "ispFingerprint": { "$ref": "#/$defs/sha256" },
            "failureDomainIndependent": { "type": "boolean" },
            "homeLanCidrs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/(?:[0-9]|[12][0-9]|3[0-2])$" }
            },
            "backupWan": {
              "type": "object",
              "additionalProperties": false,
              "required": ["available", "independentProvider", "testedAt"],
              "properties": {
                "available": { "type": "boolean" },
                "independentProvider": { "type": "boolean" },
                "testedAt": { "type": ["string", "null"], "format": "date-time" },
                "exception": { "type": ["string", "null"], "minLength": 20, "maxLength": 1000 }
              }
            }
          }
        },
        "power": {
          "type": "object",
          "additionalProperties": false,
          "required": ["laptopBatteryMinutes", "routerUpsMinutes", "independentUtilityDomain"],
          "properties": {
            "laptopBatteryMinutes": { "type": "integer", "minimum": 15, "maximum": 1440 },
            "routerUpsMinutes": { "type": "integer", "minimum": 15, "maximum": 1440 },
            "independentUtilityDomain": { "type": "boolean" }
          }
        },
        "hostPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dedicatedAppliance",
            "dualBoot",
            "nixManaged",
            "fullDiskEncryption",
            "passwordSsh",
            "rootSsh",
            "firewallEnabled",
            "publicManagementPorts",
            "sleepEnabled",
            "hibernateEnabled",
            "lidAction",
            "timeSync",
            "watchdog",
            "automaticFleetWideUpdates",
            "k3sVersion"
          ],
          "properties": {
            "dedicatedAppliance": { "const": true },
            "dualBoot": { "const": false },
            "nixManaged": { "const": true },
            "fullDiskEncryption": { "const": true },
            "passwordSsh": { "const": false },
            "rootSsh": { "const": false },
            "firewallEnabled": { "const": true },
            "publicManagementPorts": { "const": false },
            "sleepEnabled": { "const": false },
            "hibernateEnabled": { "const": false },
            "lidAction": { "const": "ignore" },
            "timeSync": { "const": true },
            "watchdog": { "const": true },
            "automaticFleetWideUpdates": { "const": false },
            "k3sVersion": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+\\+k3s[0-9]+$" }
          }
        },
        "monitoring": {
          "type": "object",
          "additionalProperties": false,
          "required": ["smart", "nvmeWear", "diskUsage", "battery", "temperature", "thermalThrottle", "clockDrift", "wan", "power", "diskWarningPercent", "diskCriticalPercent"],
          "properties": {
            "smart": { "const": true },
            "nvmeWear": { "const": true },
            "diskUsage": { "const": true },
            "battery": { "const": true },
            "temperature": { "const": true },
            "thermalThrottle": { "const": true },
            "clockDrift": { "const": true },
            "wan": { "const": true },
            "power": { "const": true },
            "diskWarningPercent": { "type": "integer", "minimum": 60, "maximum": 75 },
            "diskCriticalPercent": { "type": "integer", "minimum": 80, "maximum": 90 }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hardware", "smart", "encryption", "secureBoot", "firewall", "ssh", "power", "network", "thermal", "monitoring", "rebuildPlan", "revocationPlan"],
          "properties": {
            "hardware": { "$ref": "#/$defs/evidenceId" },
            "smart": { "$ref": "#/$defs/evidenceId" },
            "encryption": { "$ref": "#/$defs/evidenceId" },
            "secureBoot": { "$ref": "#/$defs/evidenceId" },
            "firewall": { "$ref": "#/$defs/evidenceId" },
            "ssh": { "$ref": "#/$defs/evidenceId" },
            "power": { "$ref": "#/$defs/evidenceId" },
            "network": { "$ref": "#/$defs/evidenceId" },
            "thermal": { "$ref": "#/$defs/evidenceId" },
            "monitoring": { "$ref": "#/$defs/evidenceId" },
            "rebuildPlan": { "$ref": "#/$defs/evidenceId" },
            "revocationPlan": { "$ref": "#/$defs/evidenceId" }
          }
        },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reviewer", "reviewedAt"],
          "properties": {
            "status": { "enum": ["pending", "approved", "rejected"] },
            "reviewer": { "type": "string", "minLength": 3, "maxLength": 120 },
            "reviewedAt": { "type": ["string", "null"], "format": "date-time" },
            "notes": { "type": ["string", "null"], "minLength": 20, "maxLength": 2000 }
          }
        }
      }
    }
  }
}
