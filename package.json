{
  "description": "Multi-cluster Kubernetes config for fiducia.cloud. topology.toml is the source of truth; tools/render.mjs fans it out into per-cluster kustomize inputs.",
  "name": "fiducia-infra",
  "private": true,
  "scripts": {
    "check": "node tools/render.mjs --check",
    "check:bootstrap:secrets": "node --test tools/fiducia-bootstrap-secret-readiness.test.mjs && node tools/validate-fiducia-bootstrap-secret-readiness.mjs --evidence bootstrap/fiducia-secret-readiness.example.json --allow-example --now 2026-08-03T20:30:00Z >/dev/null && bash -n scripts/capture-fiducia-bootstrap-readiness.sh",
    "check:laptop": "node tools/render-laptop-fleet.mjs --check",
    "check:laptop:acceptance": "node --test tools/laptop-acceptance.test.mjs && node tools/laptop-acceptance.mjs --evidence acceptance/laptop-fleet/evidence.example.json --allow-example --now 2026-08-03T19:00:00Z >/dev/null && bash -n scripts/capture-laptop-acceptance-checkpoint.sh",
    "check:laptop:cloud": "node --test tools/laptop-cloud-migration.test.mjs && node tools/plan-laptop-cloud-migration.mjs --observations migration/rehearsal-observations.example.json --allow-example --report-only",
    "check:laptop:gitops": "node --test tools/laptop-gitops.test.mjs && bash -n scripts/bootstrap-laptop-gitops.sh scripts/promote-laptop-cluster.sh",
    "check:laptop:host": "node --test tools/laptop-host-inventory.test.mjs && node tools/validate-laptop-inventory.mjs --inventory laptop/inventory/fleet.example.json --allow-example --now 2026-08-03T18:00:00Z >/dev/null && bash -n scripts/capture-laptop-host-evidence.sh",
    "check:laptop:messaging": "node tools/render-laptop-messaging.mjs --check && node --test tools/laptop-messaging-ha.test.mjs && node tools/validate-laptop-jetstream-evidence.mjs --evidence laptop/messaging/jetstream-evidence.example.json --allow-example --now 2026-08-03T18:05:00Z >/dev/null && bash -n scripts/apply-laptop-nats-route-tls.sh scripts/test-laptop-nats-configs.sh",
    "check:laptop:messaging:server": "bash scripts/test-laptop-nats-configs.sh",
    "check:laptop:networking": "node --test tools/laptop-networking.test.mjs && bash -n scripts/apply-laptop-runtime-secrets.sh scripts/capture-laptop-etcd-snapshot-evidence.sh scripts/restore-laptop-k3s-snapshot.sh",
    "check:managed-beta:probe-hosts": "node --test tools/managed-beta-probe-hosts.test.mjs",
    "check:raft:durability": "node --test tools/fiducia-raft-durability.test.mjs && node tools/validate-fiducia-raft-durability-evidence.mjs --evidence durability/fiducia-raft-evidence.example.json --allow-example --now 2026-08-03T20:30:00Z >/dev/null && bash -n scripts/capture-fiducia-raft-storage-evidence.sh",
    "check:tls": "node --test tools/fiducia-internal-tls.test.mjs && bash -n scripts/capture-fiducia-internal-tls-evidence.sh",
    "check:vcluster": "node tools/render-vcluster-hetzner-e2e.mjs --check",
    "plan:laptop:acceptance": "node tools/laptop-acceptance.mjs --plan",
    "plan:laptop:cloud": "node tools/plan-laptop-cloud-migration.mjs",
    "render": "node tools/render.mjs",
    "render:laptop": "node tools/render-laptop-fleet.mjs",
    "render:laptop:gitops": "node tools/render-laptop-gitops.mjs",
    "render:laptop:messaging": "node tools/render-laptop-messaging.mjs",
    "render:laptop:tailnet": "node tools/render-laptop-tailnet.mjs",
    "render:managed-beta:probe-hosts": "node tools/render-managed-beta-probe-hosts.mjs",
    "test": "node --test tools/*.test.mjs",
    "validate:bootstrap:secrets": "node tools/validate-fiducia-bootstrap-secret-readiness.mjs",
    "validate:laptop:acceptance": "node tools/laptop-acceptance.mjs",
    "validate:laptop:inventory": "node tools/validate-laptop-inventory.mjs",
    "validate:laptop:jetstream": "node tools/validate-laptop-jetstream-evidence.mjs",
    "validate:raft:durability": "node tools/validate-fiducia-raft-durability-evidence.mjs"
  },
  "type": "module",
  "version": "0.1.0"
}
