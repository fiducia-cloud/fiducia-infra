{
  "name": "fiducia-infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-cluster Kubernetes config for fiducia.cloud. topology.toml is the source of truth; tools/render.mjs fans it out into per-cluster kustomize inputs.",
  "scripts": {
    "render": "node tools/render.mjs",
    "render:laptop": "node tools/render-laptop-fleet.mjs",
    "render:laptop:gitops": "node tools/render-laptop-gitops.mjs",
    "check": "node tools/render.mjs --check",
    "check:laptop": "node tools/render-laptop-fleet.mjs --check",
    "check:laptop:gitops": "node --test tools/laptop-gitops.test.mjs && bash -n scripts/bootstrap-laptop-gitops.sh scripts/promote-laptop-cluster.sh",
    "check:vcluster": "node tools/render-vcluster-hetzner-e2e.mjs --check",
    "test": "node --test tools/*.test.mjs"
  }
}
